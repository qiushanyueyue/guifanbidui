{
    "api": {
        "builds": [
            {
                "src": "backend/run_server.py",
                "use": "@vercel/python"
            },
            {
                "src": "frontend/package.json",
                "use": "@vercel/static-build",
                "config": {
                    "distDir": "dist"
                }
            }
        ],
        "routes": [
            {
                "src": "/api/(.*)",
                "dest": "/backend/run_server.py"
            },
            {
                "src": "/(.*)",
                "dest": "/frontend/$1"
            }
        ]
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}